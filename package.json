{
  "name": "ai-job-matchmaker",
  "private": true,
  "type": "module",
  "description": "AI Job Matchmaker: reads a resume, interviews the seeker, searches job sources, and gives every job a verdict (Apply, Within reach, Not a fit) with its reasons.",
  "scripts": {
    "typecheck": "node tools/architecture/typecheck.mjs",
    "check:architecture": "node tools/architecture/check.mjs",
    "metrics": "node tools/architecture/check.mjs --metrics",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\" \"tools/**/test/*.test.mjs\"",
    "test:contract": "node --test \"packages/testing-api/contract/**/*.contract.test.ts\"",
    "eval": "node apps/main/eval/run-eval.ts",
    "smoke": "node apps/main/src/main.dev.ts smoke",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "pnpm run typecheck && pnpm run check:architecture && pnpm run lint && pnpm run test && pnpm run test:contract"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^22.0.0",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.28.0"
}
